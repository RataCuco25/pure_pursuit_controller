<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>pure_pursuit_controller</name>

  <version>0.0.0</version>

  <description>
    ROS 2 Pure Pursuit controller, path recorder, and trajectory analysis
    for a simulated ground vehicle.
  </description>

  <maintainer email="luishector.m.delrazo25@gmail.com">
    luishratacuco
  </maintainer>

  <license>Apache-2.0</license>

  <!-- ROS 2 runtime dependencies -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_python</depend>

  <!-- Testing dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
